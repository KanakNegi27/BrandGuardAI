# BrandGuard AI — Backend Environment Configuration
# Team Slayers

# Flask & JWT Security
SECRET_KEY=brandguard-super-secure-production-key-2026-slayers
JWT_SECRET_KEY=brandguard-jwt-secret-key-enterprise-2026
JWT_ACCESS_TOKEN_EXPIRES=86400
FLASK_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (MySQL 8.0+)
# Provide either a complete DATABASE_URL or individual MySQL parameters.
# If MySQL connection fails, application gracefully falls back to local SQLite (brandguard.db).
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/brandguard_db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=brandguard_db

# AI Provider Configuration
# Supported providers: 'gemini', 'openai', or 'none' (deterministic rule engine fallback)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional OpenAI / Compatible Local LLM (e.g. Ollama or vLLM)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Workspace Settings
DEFAULT_WORKSPACE_ID=1
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760
